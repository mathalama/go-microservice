# Database Configuration
# Use the appropriate database URL:
# - Doctor Service: postgres://user:password@localhost:5433/doctor_db?sslmode=disable
# - Appointment Service: postgres://user:password@localhost:5434/appointment_db?sslmode=disable
DATABASE_URL=postgres://user:password@localhost:5433/doctor_db?sslmode=disable

# NATS Configuration
NATS_URL=nats://localhost:4222

# Service Ports
DOCTOR_SERVICE_PORT=50051
APPOINTMENT_SERVICE_PORT=50052

# Service Addresses
DOCTOR_SERVICE_ADDR=localhost:50051
